# Shell scripts and sbatch files must keep LF endings — CRLF breaks the
# shebang on Linux ("bad interpreter: No such file or directory").
*.sh      text eol=lf
*.sbatch  text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.py      text eol=lf
*.command text eol=lf

# Unified patches retain upstream whitespace in their context lines.
adapters/simlingo/patches/*.patch whitespace=-blank-at-eol
